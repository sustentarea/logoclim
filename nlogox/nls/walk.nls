; __includes [
;   "check-integer.nls"
;   "file-path.nls"
;   "setup-map.nls"
; ]

; extensions [gis]

; globals [
;   index
;   dataset
;   files
;   month
;   series-data-path
;   year
; ]

to walk
  set dataset gis:load-dataset file-path series-data-path (item index files)
  set month item index months
  set year item index years
  set max-plot-x ceiling ((ticks + 1) * 1.25)

  setup-map

  if (not headless?) [
    setup-plot-window
    setup-statistics
  ]
end
