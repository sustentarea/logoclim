; __includes [
;   "list-files-by-pattern.nls"
;   "lookup-series-data-path.nls"
;   "pattern-data-file.nls"
; ]

to-report test-data
  let #path lookup-series-data-path
  let #test false

  carefully [
    set #test not empty? list-files-by-pattern #path pattern-data-file
  ] []

  report #test
end

to assert-data
  if (test-data = false) [
    let #message (word
      "There are no data available to run the model with the "
      "parameters provided. Please check your settings."
    )

    if (not headless?) [
      user-message #message
    ]

    error #message
  ]
end
