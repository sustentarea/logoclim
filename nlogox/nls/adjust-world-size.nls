; globals [dataset]

to adjust-world-size
  ; print (word
  ;   "Raster dimensions: "
  ;   gis:width-of dataset
  ;   " x "
  ;   gis:height-of dataset
  ; )

  let #width gis:width-of dataset
  let #height gis:height-of dataset

  let #max-xcor floor (#width / 2)
  let #min-xcor #max-xcor - #width + 1

  let #max-ycor floor (#height / 2)
  let #min-ycor #max-ycor - #height + 1

  resize-world #min-xcor #max-xcor #min-ycor #max-ycor

  ; print (word
  ;   "World dimensions: "
  ;   world-width
  ;   " x "
  ;   world-height
  ; )
end
