; __includes [
;   "check-list.nls"
;   "check-string.nls"
;   "check-boolean.nls"
;   "single-quote.nls"
; ]

to-report collapse [#list #sep #quote?]
  assert-list #list
  assert-string #sep
  assert-boolean #quote?

  if (#quote? = true) [set #list single-quote #list]

  report reduce [[#i #j] -> (word #i #sep #j)] #list
end
