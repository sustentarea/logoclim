; __includes [
;   "file-path.nls"
;   "lookup-series-data-path.nls"
;   "setup-fcd-variables.nls"
;   "setup-hcd-variables.nls"
;   "setup-hmwd-variables.nls"
; ]

; globals [
;   index
;   dataset
;   files
;   month
;   months
;   year
;   years
;   series-color
;   series-data-path
;   max-plot-x
;   headless?
;   settings
;   data-series
;   data-resolution
;   climate-variable
;   bioclimatic-variable
;   global-climate-model
;   shared-socioeconomic-pathway
;   start-month
;   start-year
; ]

to setup-variables [#headless?]
  assert-logical #headless?

  ifelse (#headless?) [
    set headless? true
  ] [
    set headless? false
  ]

  set series-data-path lookup-series-data-path

  (ifelse
    (data-series = "Historical Climate Data") [
      setup-hcd-variables
    ]
    (data-series = "Historical Monthly Weather Data") [
      setup-hmwd-variables
    ]
    (data-series = "Future Climate Data") [
      setup-fcd-variables
    ]
  )

  set index 0
  set dataset gis:load-dataset file-path series-data-path (item index files)
  set month item index months
  set year item index years
  set series-color lookup-series-color
  set max-plot-x 2

  set settings (list
    data-series
    data-resolution
    climate-variable
    bioclimatic-variable
    global-climate-model
    shared-socioeconomic-pathway
    start-month
    start-year
  )
end
