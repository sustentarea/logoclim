; __includes [
;   "check-integer.nls"
;   "file-path.nls"
;   "setup-map.nls"
; ]

; extensions [gis]

; globals [
;   dataset
;   files
;   month
;   series-data-path
;   year
; ]

to walk [#index]
  assert-integer #index

  set dataset gis:load-dataset file-path series-data-path (item #index files)
  set year item #index years
  set month item #index months
  set plot-x-max-range ceiling ((ticks + 1) * 1.25)

  setup-map
end
